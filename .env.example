# Copy to .env and fill in. Never commit real values.
# All three default sources (Hacker News, Stack Exchange, jobs) run without any
# of these; every variable below is optional.

# Stack Exchange API key — https://stackapps.com/apps/oauth/register. Optional;
# only raises the request quota. No key is required to collect.
STACKEXCHANGE_KEY=

# Adzuna Jobs API — https://developer.adzuna.com/ (free tier). Enables live job
# postings; without these the job collector uses an offline stub.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reddit collector — disabled by default. Set the flag to 1 to enable it, and
# the credentials only matter when it is enabled. Reddit's Data API requires
# prior approval (Responsible Builder Policy); create a "script" app at
# https://www.reddit.com/prefs/apps once approved.
SNOWWATCH_ENABLE_REDDIT=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
