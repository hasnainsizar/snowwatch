# Copy to .env and fill in. Never commit real values.

# Reddit script app — https://www.reddit.com/prefs/apps (create an app of type
# "script", ~2 minutes). Enables the authenticated OAuth API; without these the
# collector falls back to the public .json endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Adzuna Jobs API — https://developer.adzuna.com/ (free tier). Enables live job
# postings; without these the job collector uses an offline stub.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
